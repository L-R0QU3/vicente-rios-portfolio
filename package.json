{
  "name": "vicente-rios-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter @vicente-rios/web dev\" \"pnpm --filter @vicente-rios/api dev\"",
    "dev:web": "pnpm --filter @vicente-rios/web dev",
    "dev:api": "pnpm --filter @vicente-rios/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}